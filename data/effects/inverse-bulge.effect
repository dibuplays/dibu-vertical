uniform float4x4 ViewProj;
uniform texture2d image;
uniform float curve_strength = 0.55;
uniform float edge_compression = 0.45;
uniform float texture_height = 1080.0;

sampler_state textureSampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	return vert_out;
}

float4 PSFullView(VertData v_in) : TARGET
{
	float2 centered = v_in.uv * 2.0 - 1.0;
	float edge_distance = abs(centered.x);

	// Keep the outside corners full height while pulling both edges inward
	// through the middle, matching an inverse-bulge/hourglass envelope.
	float middle_weight = 1.0 - pow(edge_distance, 1.65);
	float half_height = 1.0 - curve_strength * 0.65 * middle_weight;
	float source_y = centered.y / half_height;

	// Cylindrical horizontal mapping preserves both ends and compresses the
	// sides more strongly than the centre.
	float angle = 0.35 + edge_compression * 0.95;
	float cylindrical_x = tan(centered.x * angle) / tan(angle);
	float source_x = lerp(centered.x, cylindrical_x, edge_compression);
	float2 sample_uv = float2(source_x * 0.5 + 0.5, source_y * 0.5 + 0.5);

	// Feather the curved boundary by roughly two pixels for a clean OBS edge.
	float feather = max(3.0 / max(texture_height, 1.0), 0.001);
	float mask = 1.0 - smoothstep(half_height - feather, half_height, abs(centered.y));
	float shade = 1.0 - edge_distance * curve_strength * (0.04 + edge_compression * 0.12);
	float4 color = image.Sample(textureSampler, sample_uv);
	color.rgb *= shade * mask;
	color.a *= mask;
	return color;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSFullView(v_in);
	}
}
